<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Keyrun.Sim.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Keyrun.Sim/Keyrun.Sim.csproj" />
    <ProjectReference Include="../../../tools/Keyrun.Replay/Keyrun.Replay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- f-50d8099e: the Godot-free write-movie frame picker lives with the host (game/src/Host) and is tested here. -->
    <Compile Include="../../src/Host/MovieDirector.cs" Link="Host/MovieDirector.cs" />
    <!-- The weekly affix rotation index (whole Tuesday 15:00 UTC resets since the epoch) is host-side, Godot-free, tested here. -->
    <Compile Include="../../src/Host/AffixWeek.cs" Link="Host/AffixWeek.cs" />
    <!-- f-6a00609e: the input log's Godot-free document parse and the replay's screen-frame clock and due feed. -->
    <Compile Include="../../src/Host/InputLogDocument.cs" Link="Host/InputLogDocument.cs" />
    <Compile Include="../../src/Host/ReplayClock.cs" Link="Host/ReplayClock.cs" />
    <Compile Include="../../src/Host/ReplayFeed.cs" Link="Host/ReplayFeed.cs" />
    <!-- f-7c7abdf4: the Godot-free run clock bar reading (its player-facing label) is tested here. -->
    <Compile Include="../../src/Hud/SlackReading.cs" Link="Hud/SlackReading.cs" />
    <!-- f-275d47c9: the Godot-free private Ascension readout (the Character tab and run-end panel lines) is tested here. -->
    <Compile Include="../../src/Hud/AscensionReadout.cs" Link="Hud/AscensionReadout.cs" />
    <!-- U10: the run-end panel's per-card lines (an Ascension card is an Ascension mark, not a tier bonus line) are tested here. -->
    <Compile Include="../../src/Hud/RunEndCardLines.cs" Link="Hud/RunEndCardLines.cs" />
  </ItemGroup>

</Project>
