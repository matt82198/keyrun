[sub_resource type="Environment" id="Env_arena"]
background_mode = 1
background_color = Color(0.04, 0.045, 0.06, 1)
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.56, 0.7, 1)
ambient_light_energy = 0.3

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

uniform vec4 base_color : source_color = vec4(0.36, 0.36, 0.39, 1.0);
uniform vec4 line_color : source_color = vec4(0.24, 0.24, 0.27, 1.0);
uniform vec4 major_color : source_color = vec4(0.17, 0.17, 0.2, 1.0);
uniform float cell = 1.0;
uniform float line_width = 0.035;

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float grid_line(vec2 p, float size, float width) {
	vec2 g = abs(fract(p / size - 0.5) - 0.5) * size;
	float d = min(g.x, g.y);
	float aa = fwidth(d);
	return 1.0 - smoothstep(width * 0.5, width * 0.5 + aa, d);
}

void fragment() {
	float minor = grid_line(world_pos.xz, cell, line_width);
	float major = grid_line(world_pos.xz, cell * 5.0, line_width * 2.0);
	vec3 c = mix(base_color.rgb, line_color.rgb, minor);
	c = mix(c, major_color.rgb, major);
	ALBEDO = c;
	ROUGHNESS = 0.92;
}
"

[sub_resource type="ShaderMaterial" id="Mat_grid"]
shader = SubResource("Shader_grid")

