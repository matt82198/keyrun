<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Keyrun.Bots.Tests: xUnit ports of tests/bots/** (names kept 1:1 so counts compare), excluding the cases
    that exercise bots/src/roles/** (lane 3B), plus the botprng.vectors.json parity check.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Keyrun.Bots.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Keyrun.Bots/Keyrun.Bots.csproj" />
    <ProjectReference Include="../../sim/Keyrun.Sim/Keyrun.Sim.csproj" />
    <ProjectReference Include="../../content/Keyrun.Content/Keyrun.Content.csproj" />
    <!-- Lane 3B: OracleTrace/RunSetup readers for the bot-driven trace gate (RolesOracleTraceTests). -->
    <ProjectReference Include="../../../tools/Keyrun.Replay/Keyrun.Replay.csproj" />
    <!--
      The Godot-free host (game/src/HostCore, namespace Keyrun.Host), tested as the game builds it: HostRunSetup
      (CINDER-OVERHEAT-HOST, HostRunOverheatTests), QueuedRunGate (f-e24b4fa4, QueuedRunGateTests), BotCommandSource and
      CastTargeting (HOST-PATH-THREATS, HostPathThreatTelegraphTests).
    -->
    <ProjectReference Include="../../src/HostCore/Keyrun.HostCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HOST-PATH-THREATS (bible s3): ScriptedWarden drives the autorun human seat 1 (HostPathThreatTelegraphTests), linked as
      the Keyrun.Playtest.Tests project links it (MovieFramesDefaultRunTests drives the same composition). It is Godot-free
      and stays in game/src/Host until the open PRs that own it land (S4 moved the rest to Keyrun.HostCore).
    -->
    <Compile Include="../../src/Host/ScriptedWarden.cs" Link="Host/ScriptedWarden.cs" />
    <!--
      HUD-SCOREBOARD-LIVE: the scoreboard's readings are Godot-free (the run clock, the pull header model, forces and the
      kill count), so they are compiled in here and read off the default host run (ScoreboardLiveTests).
    -->
    <Compile Include="../../src/Hud/SlackReading.cs" Link="Hud/SlackReading.cs" />
    <Compile Include="../../src/Hud/ObjectiveModel.cs" Link="Hud/ObjectiveModel.cs" />
    <Compile Include="../../src/Hud/Scoreboard.cs" Link="Hud/Scoreboard.cs" />
  </ItemGroup>

</Project>
