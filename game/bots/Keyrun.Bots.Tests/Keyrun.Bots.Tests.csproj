<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Keyrun.Bots.Tests: xUnit ports of tests/bots/** (names kept 1:1 so counts compare), excluding the cases
    that exercise bots/src/roles/** (lane 3B), plus the botprng.vectors.json parity check.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Keyrun.Bots.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Keyrun.Bots/Keyrun.Bots.csproj" />
    <ProjectReference Include="../../sim/Keyrun.Sim/Keyrun.Sim.csproj" />
    <ProjectReference Include="../../content/Keyrun.Content/Keyrun.Content.csproj" />
    <!-- Lane 3B: OracleTrace/RunSetup readers for the bot-driven trace gate (RolesOracleTraceTests). -->
    <ProjectReference Include="../../../tools/Keyrun.Replay/Keyrun.Replay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CINDER-OVERHEAT-HOST: the host's run setup is Godot-free (it only uses Keyrun.Sim, Keyrun.Content and
      Keyrun.Bots.Shared), so it is compiled in here and tested as the game builds it (HostRunOverheatTests).
    -->
    <Compile Include="../../src/Host/HostRunSetup.cs" Link="Host/HostRunSetup.cs" />
    <!--
      f-e24b4fa4 (BIBLE s10 ready check on pop): the host's queue-pop gate is Godot-free (Keyrun.Sim's ReadyCheck only),
      so it is compiled in here and driven as SimDriver drives it (QueuedRunGateTests).
    -->
    <Compile Include="../../src/Host/QueuedRunGate.cs" Link="Host/QueuedRunGate.cs" />
    <!--
      HOST-PATH-THREATS (bible s3): the default host run's two seat drivers, Godot-free, linked as the Keyrun.Playtest.Tests
      project links them (MovieFramesDefaultRunTests drives the same composition): BotCommandSource drives seats 2 and 3,
      ScriptedWarden the autorun human seat 1 (HostPathThreatTelegraphTests).
    -->
    <Compile Include="../../src/Host/BotCommandSource.cs" Link="Host/BotCommandSource.cs" />
    <Compile Include="../../src/Host/ScriptedWarden.cs" Link="Host/ScriptedWarden.cs" />
    <Compile Include="../../src/Host/CastTargeting.cs" Link="Host/CastTargeting.cs" />
    <!--
      HUD-SCOREBOARD-LIVE: the scoreboard's readings are Godot-free (the run clock, the pull header model, forces and the
      kill count), so they are compiled in here and read off the default host run (ScoreboardLiveTests).
    -->
    <Compile Include="../../src/Hud/SlackReading.cs" Link="Hud/SlackReading.cs" />
    <Compile Include="../../src/Hud/ObjectiveModel.cs" Link="Hud/ObjectiveModel.cs" />
    <Compile Include="../../src/Hud/Scoreboard.cs" Link="Hud/Scoreboard.cs" />
  </ItemGroup>

</Project>
