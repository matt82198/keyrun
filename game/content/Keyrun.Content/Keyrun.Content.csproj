<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Keyrun.Content: typed, fail-closed loader for the verbatim content JSON (ENGINE-PLAN section 4).
    HARD RULE: no Godot reference, no float/double/decimal. The JSON is NOT copied: every
    content/data/**/*.json file is embedded straight from the repo path below. Phase 4A moves the
    data to game/content/data/ and edits this one glob.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Keyrun.Content</RootNamespace>
    <AssemblyName>Keyrun.Content</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../content/data/**/*.json" LinkBase="data" LogicalName="content/data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
