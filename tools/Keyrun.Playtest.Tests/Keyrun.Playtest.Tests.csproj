<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Keyrun.Playtest.Tests: the playtest harness gates (policy parsing, the key ledger rule, no-policy parity with the
    scripted bot run, and that a policy seat does only what its plan says).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Keyrun.Playtest.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Run C's seat 1, the autorun Warden, unedited (RunCEngagesChoirTests). Godot-free; it stays in game/src/Host until
      the open PRs that own it land (S4 moved the rest of the Godot-free host to Keyrun.HostCore, referenced below).
    -->
    <Compile Include="../../game/src/Host/ScriptedWarden.cs" Link="Host/ScriptedWarden.cs" />
    <!-- f-b24741e2: Names.Ability, the one player-facing ability name path (AbilityNamesEverywhereTests). No engine types. -->
    <Compile Include="../../game/src/Host/Names.cs" Link="Host/Names.cs" />
    <!-- HudSceneTest run B's "HUD ping" calls (R-PILE-10; HudSceneRunsBKTests). The Godot-free half of Hud/Pings.cs. -->
    <Compile Include="../../game/src/Hud/PingCalls.cs" Link="Hud/PingCalls.cs" />
    <!-- f-c5fb7b31: the Godot-free objective line (pull header and remain count), driven by real Bellfoundry runs (ObjectiveTrashTests). -->
    <Compile Include="../../game/src/Hud/ObjectiveModel.cs" Link="Hud/ObjectiveModel.cs" />
    <!-- f-04dba988: the HUD's Godot-free MISS/IMMUNE word path (CombatText.cs calls it per event), driven by real runs. -->
    <Compile Include="../../game/src/Hud/CombatTextWords.cs" Link="Hud/CombatTextWords.cs" />
    <!-- R-DECLUTTER-1: the Godot-free cast proof (one placement decision per cast per step) and the unit frame model it
         reads (CastProofTests). HudDeclutter is the placement rule the proof uses. -->
    <Compile Include="../../game/src/Hud/CastProof.cs" Link="Hud/CastProof.cs" />
    <Compile Include="../../game/src/Hud/UnitFrameModel.cs" Link="Hud/UnitFrameModel.cs" />
    <Compile Include="../../game/src/Hud/HudDeclutter.cs" Link="Hud/HudDeclutter.cs" />
    <!-- f-1bf2dace: the idle-pack name label rule (one label per idle pack, edge-clipped labels hidden; IdlePackLabelsTests). -->
    <Compile Include="../../game/src/Hud/IdlePackLabels.cs" Link="Hud/IdlePackLabels.cs" />
    <!-- f-454a45a6: the party frames' Godot-free chip model (the Godot-free half of PartyFrames.cs), driven over the run C
         party with and without an Encore Chanter (StatusChipsEchoTests). -->
    <Compile Include="../../game/src/Hud/StatusChips.cs" Link="Hud/StatusChips.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Keyrun.Playtest/Keyrun.Playtest.csproj" />
    <ProjectReference Include="../../game/sim/Keyrun.Sim/Keyrun.Sim.csproj" />
    <ProjectReference Include="../../game/content/Keyrun.Content/Keyrun.Content.csproj" />
    <ProjectReference Include="../../game/bots/Keyrun.Bots/Keyrun.Bots.csproj" />
    <!--
      The Godot-free host (namespace Keyrun.Host): BotCommandSource, the reference "today's bot run" (NoPolicyParityTests);
      CastTargeting (RunCEngagesChoirTests); SeatAbandonPlan, run F's abandon-seat plan (R-415-D; SeatAbandonPlanTests,
      RunFJoinerActsTests); MovieDirector and AffixWeek, the proof-frame picker and the weekly rotation over the real
      default run (f-e1ff13e3; MovieFramesDefaultRunTests).
    -->
    <ProjectReference Include="../../game/src/HostCore/Keyrun.HostCore.csproj" />
  </ItemGroup>

</Project>
